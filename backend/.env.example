# GreenGrid backend configuration
PORT=5107
MONGODB_URI=
USE_MEMORY_DB=
JWT_SECRET=change-me-to-a-long-random-string
CLIENT_ORIGIN=http://localhost:5307
# Optional: OpenWeather API key for real forecasts (https://openweathermap.org/api — free tier)
# Without it, a deterministic simulated forecast is used so every feature still works.
OPENWEATHER_API_KEY=
